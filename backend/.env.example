# Gemini API configuration
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-2.0-flash-lite

# Optional: Set to 'true' to use deterministic offline classifier without API calls
USE_MOCK_CLASSIFIER=false

# Optional: Path to SQLite database file
CIVICGRID_DB_PATH=data/civicgrid.db

# Optional: Comma-separated list of allowed CORS origins (e.g. https://my-app.vercel.app)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
